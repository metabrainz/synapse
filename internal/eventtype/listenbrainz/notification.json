{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotificationEvent",
  "type": "object",
  "required": [
    "actor",
    "message"
  ],
  "properties": {
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "actor": {
      "title": "Actor",
      "type": "object",
      "required": [
        "username",
        "url"
      ],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
